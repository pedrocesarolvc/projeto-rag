# Variáveis de ambiente do projeto, lidas por app/config.py.
# Cada variável nasce quando a etapa que depende dela é implementada
# — nenhuma entra aqui só porque pode ser útil no futuro.

# String de conexão do PostgreSQL com a extensão pgvector habilitada.
# Necessária a partir da Etapa 3 (armazenamento de vetores).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/rag

# Chave de API do provedor de embeddings e da LLM (nome exato da
# variável definido quando o provedor for escolhido nas Etapas 3 e 5).
